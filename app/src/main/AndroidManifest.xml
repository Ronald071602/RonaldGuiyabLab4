<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RonaldGuiyabLab4">

        <!-- Explore Activity -->
        <activity
            android:name=".ExploreActivity"
            android:exported="true"
            android:label="Explore"
            android:theme="@style/Theme.RonaldGuiyabLab4" />

        <!-- Gallery Activity -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:label="Gallery"
            android:theme="@style/Theme.RonaldGuiyabLab4" />

        <!-- Ticketing Activity -->
        <activity
            android:name=".TicketingActivity"
            android:exported="true"
            android:label="Ticketing Service"
            android:theme="@style/Theme.RonaldGuiyabLab4" />

        <!-- Artists Activity -->
        <activity
            android:name=".ArtistsActivity"
            android:exported="true"
            android:label="Artists"
            android:theme="@style/Theme.RonaldGuiyabLab4" />

        <!-- Exhibit Activity (detail page when clicking an artwork image) -->
        <activity
            android:name=".ExhibitActivity"
            android:exported="true"
            android:label="Exhibit"
            android:theme="@style/Theme.RonaldGuiyabLab4" />

        <!-- Main Activity (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RonaldGuiyabLab4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
